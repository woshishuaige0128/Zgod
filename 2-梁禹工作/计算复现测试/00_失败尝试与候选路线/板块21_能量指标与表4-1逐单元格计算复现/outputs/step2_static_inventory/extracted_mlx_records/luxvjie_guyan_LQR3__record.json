      "style": "text",
      "text": "定义循环，求解稳定域",
      "text_sha256": "1F02EA3680ADE6C074E485CF9E12A8E6A0372679B1ED9B1F154F0AD4D2AC46E5",
      "xml_xpath": "/w:document/w:body/w:p[8]"
