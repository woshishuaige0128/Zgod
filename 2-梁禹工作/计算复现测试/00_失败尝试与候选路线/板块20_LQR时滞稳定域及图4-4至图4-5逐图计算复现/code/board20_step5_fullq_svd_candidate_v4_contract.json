  "root_and_pairing_policy": {
    "root_generation_unchanged_from_v2": true,
    "selected_full_q_raw_roots": "Every scipy.linalg.eig root of the ordinary full-q history companion is saved, including numerical splits of exact multiple zero roots.",
    "selected_compact_raw_roots": "For matrix_order>5 every compact root is selected and saved. For matrix_order<=5 every auxiliary compact root is saved for deterministic pairing only.",
    "fixed_zero_rule": "Only if clearing_power>0, remove a finite root with abs(root)<=max(1e-12,100*eps*solver_order*max(1,median(abs(finite_nonzero_roots)))). This is exactly the V2 rule; no theoretical-count deletion or root correction is allowed.",
    "selected_full_q_rho": "max(abs(all finite full-q roots above the fixed zero tolerance)); unmatched full-q roots remain in this maximum.",
    "pairing_cost": "abs(compact_i-full_j)/max(1,abs(compact_i),abs(full_j))",
    "pairing_algorithm": "scipy.optimize.linear_sum_assignment on rows=all retained compact roots and columns=all retained full-q roots, preserving eig-array order. Every pair index and pair cost is saved.",
    "pairing_failure": "If retained full-q count is smaller than retained compact count, the point fails.",
    "gated_physical_roots": "For a full-q-selected route, all deterministically matched retained full-q roots. For a compact-selected route, all retained compact roots.",
    "unmatched_full_policy": "Every unmatched full-q root remains saved and remains in rho. It is never deleted, corrected, or forced to zero. Its direct-SVD and vector-block residuals are diagnostic only because it represents numerical splitting of cleared-denominator origin multiplicity.",
    "compact_conditioning_diagnostic": "Full-q/compact rho difference, all-root optimal matching distance, and abs(z)>=0.9 root-set distance are DIAGNOSTIC_ONLY_KNOWN_COMPACT_CONDITIONING and are not V4 candidate PASS gates. Stable classification equality remains a hard gate."
  },
  "hard_residual_math": {
    "matrix_norm": "spectral 2-norm",
    "polynomial_definition": "For P(z)=sum_k A_k z^k, r_P(z)=sigma_min(P(z))/sum_k ||A_k||_2 |z|^k.",
    "laurent_definition": "For G(z)=sum_e B_e z^e, r_G(z)=sigma_min(G(z))/sum_e ||B_e||_2 |z|^e, using the original unconsolidated direct Laurent terms.",
    "scale_stable_evaluation": "For nonzero finite z, let h_e=e*log(|z|)+log(||B_e||_2), h=max_e h_e. Form Gs=sum_e exp(h_e-h)*exp(i*e*arg(z))*B_e/||B_e||_2 and ds=sum_e exp(h_e-h). Return sigma_min(Gs)/ds. The same rule with k>=0 is used for P. This is algebraically the stated normalized residual and avoids overflow/underflow.",
    "zero_boundary": "At z=0, polynomial terms with k>0 vanish and k=0 terms are evaluated by the same common scaling. A Laurent expression containing a negative exponent is undefined and recorded as +Inf. Cleared zero roots are not gated.",
    "hard_gate_scope": "Both r_P and r_G must be finite and <=1e-8 for every gated physical root.",
    "svd_vector": "No companion eigenvector or fitted null vector is used: sigma_min is computed directly from the scaled characteristic matrix.",
    "old_vector_residual_role": "The V2 residuals obtained by substituting the leading matrix_order entries of the ordinary/compact companion eigenvector are saved for every finite root as DIAGNOSTIC_ONLY_VECTOR_BLOCK_CONDITIONING. They never determine V4 PASS/FAIL.",
    "near_unit_and_dominant_reporting": "For gated roots with abs(z)>=0.9 and for the selected dominant root, report maxima/values of both direct-SVD residuals and old vector-block residuals."
  },
