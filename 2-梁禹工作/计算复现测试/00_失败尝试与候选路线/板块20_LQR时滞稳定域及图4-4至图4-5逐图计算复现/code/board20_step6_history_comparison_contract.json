{
  "schema_version": "board20_step6_history_comparison_contract_v1",
  "created_date": "2026-08-25",
  "purpose": "Compare every available continuous rho grid with the six historical plotting masks on the exact common 31x67 physical grid, preserve missing and conflicting routes, and render evidence-separated candidate figures without fitting.",
  "path_base": "parent directory of this contract's code directory",
  "immutability_rule": "All bound inputs are read-only. Writes are limited to the two fixed Step-6 output directories, the Step-6 validation directory, and the Step-6 log directory.",
  "grid_contract": {
    "shape": [31, 67],
    "point_count": 2077,
    "l_start": 0,
    "l_end": 30,
    "j_start": 0,
    "j_end": 66,
    "logical_indexing": "mask[l,j] = MATLAB mask(l+1,j+1)",
    "horizontal_coordinate": "tau1_ms = j * 1000 / 1024",
    "vertical_coordinate": "tau2_ms = l * 1000 / 1024",
    "dt_seconds": 0.0009765625,
    "dt_milliseconds": 0.9765625,
    "stable_rule": "finite(rho) and rho < 1.0",
    "historical_rule": "finite(value) and value > 0.0 and value < 1.0",
    "axis_intercept_definition": "ORIGIN_CONNECTED_CONTIGUOUS_PREFIX_LAST_STABLE_INDEX_NO_HOLE_CROSSING",
    "critical_tolerance": 1e-08,
    "calculation_level_mask_mismatch_gate": 0,
    "calculation_level_boundary_row_mismatch_gate": 0
  },
