{
  "schema_version": "board20_step5_independent_compute_contract_v1",
  "purpose": "Independent Python time-domain scalar-delay augmentation for the five sealed author file-identity routes. This contract never uses MATLAB spectral-radius results as computation inputs.",
  "path_base": "parent directory of this contract's code directory",
  "route_manifest_relpath": "code/board20_step4_route_manifest.json",
  "route_manifest_sha256": "397564F6884DE082995D04DF9AB62F13244DFA8C6129BDDB1F18A2DF0BE88D6E",
  "manifest_field_policy": {
    "allowed": [
      "route_id",
      "route_name",
      "route_role",
      "declared_method",
      "division",
      "route_formula",
      "workspace_relpath",
      "matrix_variable_map",
      "file_contracts"
    ],
    "workspace_contract_role": "workspace_complete",
    "forbidden_scientific_input_names": [
      "rho",
      "poles",
      "stable",
      "critical",
      "residual",
      "stab"
    ],
    "statement": "The manifest is consumed only for route identity, matrix-variable identity, workspace path, and the workspace SHA-256 seal. Grid result paths and all MATLAB numerical results are ignored."
  },
  "allowed_input_roots": [
    "code",
    "outputs/step2_runs"
  ],
  "output_root_relpath": "outputs/step5_independent_compute",
  "log_root_relpath": "logs/step5",
  "numeric_gates": {
    "rho_finite_and_strictly_positive": true,
    "max_polynomial_residual": 1e-8,
    "max_direct_laurent_residual": 1e-8,
    "direct_formula_coefficient_relative_difference": 1e-12,
    "compact_full_rho_absolute_difference": 1e-8,
    "compact_full_root_relative_matching_difference": 1e-8,
    "near_unit_root_threshold": 0.9,
    "near_unit_root_relative_matching_difference": 1e-8,
    "stable_definition": "rho < 1",
    "critical_definition": "abs(rho - 1) <= 1e-8",
    "zero_root_rule": "Only when clearing_power>0, remove finite roots whose magnitude is at most max(1e-12,100*eps*solver_order*max(1,median(abs(finite_nonzero_roots))))."
  },
  "matlab_storage_policy": {
    "format": "MATLAB v7.3 HDF5",
    "array_restore": "Every numeric dataset is converted to float64 and transposed after h5py read.",
    "right_division": "M/al is computed only as scipy.linalg.solve(al.T,M.T).T; no inverse and no elementwise division."
  },
  "augmentation_policy": {
    "compact_state": "[q_k,q_(k-1),channel-1 scalar delay chain,channel-2 scalar delay chain]",
    "compact_order": "2*n+l+j",
    "right_H_signal": "y_r(k)=e_r^T q_k; q_k and q_(k-1) supply the first two values and only d older scalars are appended.",
    "left_H_signal": "u_r(k)=row_r(D0) q_k + row_r(Dminus1) q_(k-1); only d past u values are appended.",
    "full_q_crosscheck": "Every one of the 41 real pilot points is also solved by the ordinary full-q history companion matrix. The exact algebraic order difference is at z=0, but a high-multiplicity zero can split into nonzero numerical roots in the ordinary companion eigensolve. The fixed zero tolerance must not be relaxed and roots must not be deleted by expected count. Strict all-root matching is therefore retained as DIAGNOSTIC_ONLY; rho, stable class, and roots with abs(z)>=0.9 remain acceptance gates.",
    "full_q_order": "n*(max(l,j)+2)"
  },
  "modes": {
    "preflight": "Read-only input and contract checks; writes only preflight metadata.",
    "selftest": "Deterministic synthetic algorithm tests; no project scientific result.",
    "pilot": "Exactly 41 sealed-workspace points; compact and full-q solvers both run.",
    "full": "Five independent 31x67 grids using the compact solver; creates atomic checkpoints.",
    "resume": "Resume the full-grid checkpoint only after code, contract, manifest, and workspace identity checks pass."
  },
  "full_grid": {
