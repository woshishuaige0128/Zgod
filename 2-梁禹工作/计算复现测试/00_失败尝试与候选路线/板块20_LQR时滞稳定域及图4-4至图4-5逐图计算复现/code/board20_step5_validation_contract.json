  "scalar_delay_state_contract": {
    "state": "x_k=[q_k,q_(k-1),scalar_chain_1,scalar_chain_2]",
    "channel_chain_orders": "[l,j]",
    "compact_scalar_augmented_order": "2*matrix_order+l+j",
    "full_q_companion_pilot_order": "matrix_order*(max(l,j)+2)",
