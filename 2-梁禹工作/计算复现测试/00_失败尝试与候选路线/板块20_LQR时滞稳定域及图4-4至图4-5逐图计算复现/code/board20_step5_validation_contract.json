    "left_H_signal": "u_r(k)=e_r^T D0 q_k+e_r^T Dm1 q_(k-1)",
    "div2_feedback": "S^T(DeltaC/dt+DeltaK)S and S^T(-DeltaC/dt)S are undelayed and outside H"
  },
